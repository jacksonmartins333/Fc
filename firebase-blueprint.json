{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "Represents a soccer player in the pelada.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["mensalista", "avulso"] },
        "rating": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["pago", "pendente", "atrasado"] },
        "isGoalkeeper": { "type": "boolean" },
        "isPresent": { "type": "boolean" },
        "isInjuredOrTired": { "type": "boolean" },
        "injuryReason": { "type": "string", "enum": ["tired", "injured", "left"] },
        "stats": {
          "type": "object",
          "properties": {
            "goals": { "type": "number" },
            "assists": { "type": "number" },
            "matchesWon": { "type": "number" },
            "matchesPlayed": { "type": "number" },
            "goalsConceded": { "type": "number" }
          }
        },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "type", "rating", "paymentStatus", "isGoalkeeper", "isPresent", "stats"]
    },
    "Match": {
      "title": "Match",
      "description": "Represents a pelada match.",
      "type": "object",
      "properties": {
        "teamA": { "type": "object" },
        "teamB": { "type": "object" },
        "status": { "type": "string", "enum": ["not_started", "in_progress", "finished"] },
        "events": { "type": "array" },
        "startTime": { "type": "number" },
        "matchNumber": { "type": "number" },
        "winnerTeamId": { "type": "string" },
        "finishedAt": { "type": "number" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["teamA", "teamB", "status", "events"]
    },
    "Settings": {
      "title": "Settings",
      "description": "App settings for the pelada",
      "type": "object",
      "properties": {
        "pixKey": { "type": "string" },
        "maxPlayersPerTeam": { "type": "number" },
        "numberOfTeams": { "type": "number" },
        "matchDurationMinutes": { "type": "number" },
        "currentTeams": { "type": "array" },
        "teamQueue": { "type": "array" },
        "benchPlayers": { "type": "array" },
        "adminPinHash": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "shared/data/players/{playerId}": {
      "schema": { "$ref": "#/entities/Player" },
      "description": "Players in the shared pelada roster"
    },
    "shared/data/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Matches in the shared pelada"
    },
    "shared/data/settings/app": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Global settings and match configuration for the pelada"
    }
  }
}

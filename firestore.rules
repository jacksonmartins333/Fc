rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Blueprint for Player
    function isValidPlayer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.type in ['mensalista', 'avulso']
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.paymentStatus in ['pago', 'pendente', 'atrasado']
        && data.isGoalkeeper is bool
        && data.isPresent is bool
        && data.stats is map
        && data.stats.goals is number && data.stats.goals >= 0 && data.stats.goals <= 1000
        && data.stats.assists is number && data.stats.assists >= 0 && data.stats.assists <= 1000;
    }

    // Validation Blueprint for Match
    function isValidMatch(data) {
      return data.teamA is map
        && data.teamB is map
        && data.status in ['not_started', 'in_progress', 'finished']
        && data.events is list
        && data.events.size() <= 500;
    }

    // Validation Blueprint for Settings
    function isValidSettings(data) {
      return (!('maxPlayersPerTeam' in data) || (data.maxPlayersPerTeam is number && data.maxPlayersPerTeam >= 2 && data.maxPlayersPerTeam <= 20))
        && (!('numberOfTeams' in data) || (data.numberOfTeams is number && data.numberOfTeams >= 2 && data.numberOfTeams <= 10))
        && (!('matchDurationMinutes' in data) || (data.matchDurationMinutes is number && data.matchDurationMinutes >= 1 && data.matchDurationMinutes <= 60))
        && (!('pixKey' in data) || (data.pixKey is string && data.pixKey.size() <= 120));
    }

    // Health check endpoint
    match /test/{testId} {
      allow read: if true;
    }

    match /shared/data {
      match /players/{playerId} {
        allow read, list: if true;
        allow create: if isValidId(playerId) && isValidPlayer(incoming());
        allow update: if isValidId(playerId) && isValidPlayer(incoming());
        allow delete: if isValidId(playerId);
      }

      match /matches/{matchId} {
        allow read, list: if true;
        allow create: if isValidId(matchId) && isValidMatch(incoming());
        allow update: if isValidId(matchId) && isValidMatch(incoming());
        allow delete: if isValidId(matchId);
      }

      match /settings/{settingId} {
        allow read, list: if true;
        allow create, update: if isValidId(settingId) && isValidSettings(incoming());
        allow delete: if isValidId(settingId);
      }
    }
  }
}
